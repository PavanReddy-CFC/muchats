# Copy to apps/api/.env for local development.

NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://qennect:qennect@localhost:5432/qennect_chat
REDIS_URL=redis://localhost:6379/0

JWT_ACCESS_SECRET=dev-access-secret-change-me-please-32chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-please-32chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

CORS_ORIGIN=*

# Optional — only required for image-attachment uploads (POST /attachments/upload-url,
# GET /attachments/:id). Leave unset in dev if you don't need image sending; those two
# endpoints will return a clear 500 instead of the whole API failing to start.
# S3_BUCKET=qennect-chat-attachments
# S3_REGION=auto
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com   # only for R2 / non-AWS S3
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Optional — only required for push notifications. Each tenant configures its own Firebase
# project's service account via PUT /push/tenant-config (admin-only); this key just encrypts
# that secret at rest, deployment-wide. Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# PUSH_CONFIG_ENCRYPTION_KEY=
